GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
N8N_WEBHOOK_URL=your_n8n_webhook_url_here

# Google Analytics 4 — set to your Measurement ID (e.g. G-XXXXXXXXXX) to enable
# site analytics. When set, the GA script loads and the CSP auto-allows GA domains.
# Leave blank/unset to disable analytics entirely (no script, no extra requests).
NEXT_PUBLIC_GA_ID=

# Meta / Facebook Pixel — set to your Pixel ID to enable conversion tracking.
# Leave blank/unset to disable (no script loads). CSP auto-allows FB domains when set.
NEXT_PUBLIC_FB_PIXEL_ID=
